@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Context.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()

title System Context — contractact-u-ally

Person(worker, "Worker")
System(app, "contractact-u-ally", "PDF in, risk report out")
System_Ext(mistral, "Mistral OCR")
System_Ext(anthropic, "Anthropic Claude")

Rel(worker, app, "Uploads PDF · reads report")
Rel(app, mistral, "PDF → text")
Rel(app, anthropic, "Stream analysis")
@enduml
