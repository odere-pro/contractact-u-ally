# contractact-u-ally — Processing algorithm (horizontal)
# Render: d2 docs/diagrams/src/algorithm-pipeline.d2 docs/diagrams/img/algorithm-pipeline.svg

direction: right

upload: "Upload PDF\n/api/ocr"
ocr: "OCR\n(Mistral)"
classify: "Classify\ncontract type"
rules: "Load rules\nfor type + jurisdiction"
prompt: "Build prompt"
stream: "Claude stream\n(text deltas)"
validate: "Validate line\n(zod)" {shape: diamond}
emit: "Emit NDJSON\n(clause / summary)"
done: "Stream end"

upload -> ocr
ocr -> classify
classify -> rules
rules -> prompt
prompt -> stream
stream -> validate
validate -> emit: ok
validate -> stream: drop\n(invalid)
emit -> stream: next delta
emit -> done: summary
