@startuml c4-component-pipeline
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/v2.10.0/C4_Component.puml

LAYOUT_LEFT_RIGHT()
HIDE_STEREOTYPE()

title Components — runRiskPipeline

Container(analyze, "/api/analyze", "Route handler")

System_Boundary(pipe, "runRiskPipeline") {
  Component(orch, "Orchestrator", "Owns ReadableStream")
  Component(classifier, "classifier", "Detect contract type")
  Component(rules, "ruleLoader", "Load rules + jurisdiction")
  Component(prompts, "prompts", "Build system prompt")
  Component(schemas, "zod schemas", "Validate each NDJSON line")
}

System_Ext(anthropic, "Anthropic Claude")

Rel(analyze, orch, "run")
Rel(orch, classifier, "classify(text)")
Rel(orch, rules, "load(typeId)")
Rel(orch, prompts, "build")
Rel(orch, anthropic, "messages.stream")
Rel(orch, schemas, "validate line")
Rel(orch, analyze, "NDJSON events")
@enduml
