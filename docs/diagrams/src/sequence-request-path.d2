# contractact-u-ally — Request path (D2 sequence)
# Render: d2 docs/diagrams/src/sequence-request-path.d2 docs/diagrams/img/sequence-request-path.svg

shape: sequence_diagram

browser: Browser
ocr: /api/ocr
analyze: /api/analyze
pipe: runRiskPipeline
catalog: Rule Catalog
mistral: Mistral OCR
claude: Anthropic Claude

browser -> ocr: POST PDF
ocr -> mistral: PDF bytes
mistral -> ocr: text
ocr -> browser: ocrText

browser -> analyze: "POST ocrText + jurisdiction"
analyze -> pipe: run

pipe -> catalog: classify
catalog -> pipe: typeId
pipe -> catalog: load rules
catalog -> pipe: ruleSet

pipe -> claude: messages.stream

"loop — per text_delta": {
  claude -> pipe: delta
  pipe -> pipe: parse + zod
  pipe -> browser: NDJSON clause or summary
}

claude -> pipe: end
pipe -> browser: stream end
