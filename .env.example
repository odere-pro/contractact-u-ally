# contractact-u-ally — server-side environment.
# Copy to `.env.local` for development. NEVER commit `.env.local`.

# Anthropic Claude (used by /api/analyze for classification + risk analysis).
# Read implicitly by @anthropic-ai/sdk.
ANTHROPIC_API_KEY=

# Mistral OCR (used by /api/ocr to extract text from PDF uploads).
# When unset, /api/ocr returns 503 — the rest of the app still loads.
MISTRAL_API_KEY=
