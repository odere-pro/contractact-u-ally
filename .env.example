# contractact-u-ally — server-side environment.
# Copy to `.env.local` for development. NEVER commit `.env.local`.

# Anthropic Claude (used by /api/analyze, /api/answer, /api/translate).
# Read implicitly by @anthropic-ai/sdk.
ANTHROPIC_API_KEY=

# Mistral OCR (used by /api/analyze to extract text from PDF uploads).
# When unset, /api/analyze returns 503.
MISTRAL_API_KEY=

# Reson8 speech-to-text (used by /api/transcribe and /api/reson8-model
# for the voice Q&A flow). When unset, the mic button on each clause
# card returns 503 and falls back to typed-only Q&A.
RESON8_API_KEY=
